{
  "name": "puppetmaster",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first platform unifying an AI Agent OS and AI workflow automation",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run verify:deterministic",
    "eval": "pnpm --filter @puppetmaster/server eval",
    "verify:dist": "pnpm -r build",
    "verify:deterministic": "pnpm run verify:dist && pnpm run verify:arch && node scripts/verify-claude-stream.mjs && node scripts/verify-delegate-parse.mjs && node scripts/verify-claude-persistence.mjs && node scripts/verify-claude-routes.mjs && node scripts/verify-openai-coding-runtime.mjs && node scripts/verify-claude-cancellation-races.mjs && node scripts/verify-workbench-copyback-recovery.mjs && node scripts/verify-runner-lifecycle.mjs && node scripts/verify-server-hardening.mjs && node scripts/verify-provider-readiness.mjs && node scripts/verify-env-bootstrap.mjs && node scripts/verify-workbench-secret-transport.mjs && node scripts/verify-workbench-sync.mjs && pnpm run verify:science:safe",
    "verify:arch": "pnpm exec depcruise apps/server/src apps/web/src packages/db/src packages/kernel/src packages/mcp-connectors/src packages/shared/src packages/ui/src --config .dependency-cruiser.cjs --output-type err",
    "verify:claude-stream": "pnpm run verify:dist && node scripts/verify-claude-stream.mjs",
    "verify:delegate-parse": "pnpm run verify:dist && node scripts/verify-delegate-parse.mjs",
    "verify:claude-persistence": "pnpm run verify:dist && node scripts/verify-claude-persistence.mjs",
    "verify:claude-routes": "pnpm run verify:dist && node scripts/verify-claude-routes.mjs",
    "verify:openai-coding": "pnpm run verify:dist && node scripts/verify-openai-coding-runtime.mjs",
    "verify:openai-plan-docker": "pnpm run verify:dist && node scripts/verify-openai-plan-isolation.mjs",
    "verify:claude-control-plane-docker": "pnpm run verify:dist && node scripts/verify-claude-control-plane.mjs",
    "verify:claude-live-docker": "pnpm run verify:claude-control-plane-docker",
    "verify:openai-live": "pnpm run verify:dist && node --env-file-if-exists=.env scripts/verify-openai-live.mjs",
    "verify:claude-cancellation": "pnpm run verify:dist && node scripts/verify-claude-cancellation-races.mjs",
    "verify:server-hardening": "pnpm run verify:dist && node scripts/verify-server-hardening.mjs",
    "verify:provider-readiness": "pnpm run verify:dist && node scripts/verify-provider-readiness.mjs",
    "verify:env-bootstrap": "pnpm run verify:dist && node scripts/verify-env-bootstrap.mjs",
    "verify:workbench-sync": "node scripts/verify-workbench-sync.mjs",
    "verify:workbench-secret-transport": "pnpm run verify:dist && node scripts/verify-workbench-secret-transport.mjs",
    "verify:workbench-copyback-recovery": "pnpm run verify:dist && node scripts/verify-workbench-copyback-recovery.mjs",
    "verify:runner-lifecycle": "pnpm run verify:dist && node scripts/verify-runner-lifecycle.mjs",
    "verify:science": "pnpm run verify:dist && pnpm run verify:science:safe",
    "verify:science:safe": "node scripts/verify-science-golden.mjs",
    "verify:science:golden": "node scripts/verify-science-golden.mjs",
    "verify:science:deployment": "pnpm --filter @puppetmaster/kernel build && node scripts/verify-science-deployment.mjs",
    "verify:science:recovery": "node scripts/verify-science-recovery.mjs",
    "verify:science:scheduler": "node scripts/verify-science-scheduler.mjs",
    "verify:science:workflow": "pnpm --filter @puppetmaster/shared build && pnpm --filter @puppetmaster/kernel build && pnpm --filter @puppetmaster/server build && node scripts/verify-science-workflow.mjs",
    "verify:science:workflow-resume": "node scripts/verify-workflow-deferred-resume.mjs",
    "verify:science:workflow-isolation": "node scripts/verify-workflow-workspace-isolation.mjs",
    "verify:science:redis-live": "pnpm --filter @puppetmaster/kernel build && node scripts/verify-science-redis-live.mjs",
    "verify:science:jupyter-gateway": "pnpm --filter @puppetmaster/kernel build && node scripts/verify-science-jupyter-gateway.mjs",
    "verify:science:oci-executor": "node scripts/run-science-oci-executor-verifier.mjs",
    "verify:science:audit": "node scripts/verify-science-audit-atomicity.mjs",
    "verify:science:browser": "pnpm run verify:dist && playwright test --config=playwright.science.config.ts",
    "verify:science:browser:headed": "pnpm run verify:dist && playwright test --config=playwright.science.config.ts --headed",
    "verify:science:browser:list": "playwright test --config=playwright.science.config.ts --list",
    "verify:workbench": "pnpm run verify:dist && node scripts/verify-workbench.mjs",
    "verify:egress": "pnpm run verify:dist && node scripts/verify-egress.mjs",
    "verify:docker": "pnpm run verify:dist && node scripts/verify-workbench.mjs && node scripts/verify-egress.mjs && node scripts/verify-openai-plan-isolation.mjs && node scripts/verify-claude-control-plane.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "dependency-cruiser": "^18.0.0"
  }
}
