    "@puppetmaster/mcp-connectors": "workspace:*",
    "@puppetmaster/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "jose": "^6.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
